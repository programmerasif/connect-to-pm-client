generator client {
  provider   = "prisma-client"
  output     = "../generated/prisma"
  engineType = "binary"
}

datasource db {
  provider = "mysql"
}

model AdminUser {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Complaint {
  id        String   @id @default(uuid())
  name      String
  email     String?
  number    String
  address   String   @db.Text
  message   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Volunteer {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  number    String
  address   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
